# AutoRFQ settings. Copy this file to .env (same folder) and fill in what you use.
# .env is git-ignored: never commit it, paste it in chat, or show it on screen.
# Read by rfq/build.py, mailbot.py and the web app (rfq/infra/env.py). On Azure, the same names are
# App settings: `python scripts/deploy_azure.py --with-secrets` copies the filled ones over.

# --- Email bot (mailbot.py) and "Approve & send" in the web app -----------------------------------
# The team Gmail address and its 16-letter App Password (not the normal password):
# Google Account -> Security -> 2-Step Verification (turn on) -> App passwords -> name it "RFQ bot".
# Spaces in the password don't matter.
BOT_EMAIL=
BOT_PASSWORD=
# Optional: who gets "RFQ from X needs review" when an RFQ is held, and the link put in that notice.
REVIEW_NOTIFY_EMAIL=
DASHBOARD_URL=http://127.0.0.1:8000

# --- Quality agent: LLM check (optional; rules, units and blanks run without it) ----------------
# Either OpenAI (the same key as Days 2 and 3) ...
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# ... or Azure OpenAI (used instead when all three are set).
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21

# --- Competitor codes with no description (optional web search) ----------------------------------
SERPAPI_API_KEY=

# --- Run settings (defaults are fine locally) ----------------------------------------------------
# RFQ_MODE=no-browser       # forced on Azure: no Chrome in the cloud
# RFQ_OUT_DIR=out           # where runs are written (Azure Functions: /tmp/autorfq)
# RFQ_AUTO_BROWSER=1        # live runs open the scraping Chrome and close it when done
